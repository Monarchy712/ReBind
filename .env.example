# Rebind environment. Copy to .env and fill in. .env is gitignored — never commit it.

# --- Keys -------------------------------------------------------------------
# Two SEPARATE keys. Keeping them apart is the trust model, not a formality.
# DEPLOYER_PK deploys the contracts, owns the token, and acts as issuer.
# ATTESTOR_PK signs equivalence attestations only.
# Base Sepolia faucet: https://www.alchemy.com/faucets/base-sepolia
DEPLOYER_PK=
ATTESTOR_PK=

# Optional: pin the attestor address explicitly. If unset, deploy.js derives it
# from ATTESTOR_PK.
ATTESTOR_ADDRESS=

# --- Chain ------------------------------------------------------------------
RPC_URL=https://sepolia.base.org
MONAD_RPC=https://testnet-rpc.monad.xyz

# --- Local demo mode --------------------------------------------------------
# DEMO_MODE=local runs the whole flow against a Hardhat node with an in-memory
# Cleanverse stub: no testnet funds, no API credentials, no register_atoken
# approval wait. Leave this UNSET for a real deployment. Set by `npm run
# server:local`, so you normally do not put it here.
#
# When local mode is on, RPC_URL is ignored in favour of LOCAL_RPC — so you can
# keep your testnet endpoint above and switch modes without editing anything.
LOCAL_RPC=http://127.0.0.1:8545

# ETH given to DEPLOYER_PK and ATTESTOR_PK by `npm run fund:local`.
LOCAL_FUND_ETH=1000

# --- Cleanverse API ---------------------------------------------------------
# CV_API_KEY is base64 — the client decodes it before use. A 403 from Cleanverse
# is almost always an AES problem, not auth.
CV_API_ID=
CV_API_KEY=
CV_BASE_URL=https://uatapi.cleanverse.com/api/cooperate
CV_CHAIN=base

# Set to "true" only if `npm run freeze-test` PASSES, i.e. update_status freezes
# a single wallet rather than the whole customerId. If it FAILS, leave this
# false and rely on registry.revokeWallet() alone.
CV_FREEZE_PER_WALLET=false

# --- Token ------------------------------------------------------------------
TOKEN_NAME=Series A Note
TOKEN_SYMBOL=NOTE
TOKEN_ICON=https://images.cleanverse.com/app/token_icon/USDC.svg

# --- Recovery ---------------------------------------------------------------
# Challenge/cure window in seconds. 30 keeps a live demo snappy. A real
# deployment would use 24h+ (86400) so a human reviewer has time to reject a
# fraudulent claim before it becomes executable.
CURE_WINDOW=30

# Salt for the identity commitment hash. Any long random string; keep it stable
# across a deployment or previously issued commitments stop matching.
IDENTITY_COMMITMENT_SALT=

# --- Guardian ---------------------------------------------------------------
# Co-signs recovery claims. It exists so that compromising ATTESTOR_PK is not
# enough to forge one, so it MUST be a different key — the backend refuses to
# fall back to the attestor. Local mode derives a disposable one automatically.
GUARDIAN_PK=

# --- Bridge advance ---------------------------------------------------------
# Lending against a committed claim while the cure window runs.
# Set to "false" to deploy without a vault; the executor then takes address(0)
# and behaves exactly as it did before advances existed.
BRIDGE_ADVANCE=true

# Share of the claim advanced, and the origination fee, in basis points.
# The gap below 100% is the vault's safety margin against the claim's value
# falling before it settles.
ADVANCE_LTV_BPS=8000
ADVANCE_FEE_BPS=50

# Stable liquidity seeded into the vault at deploy, in whole units.
ADVANCE_SEED=100000

# On a network with a real stablecoin, point this at it and DemoStablecoin is
# never deployed. Leave blank for local and testnet demos.
STABLE_ADDRESS=

# Optional fallback receiver address for repayment failures (e.g. if the vault's binding is revoked).
# If unset, the deploy script defaults to deployer.address.
FALLBACK_RECEIVER=

# --- Demo wallets -----------------------------------------------------------
# Served to the UI by GET /api/config. Alice's first wallet, her recovery
# destination, the attacker, and her guardian co-signer.
#
# LIVE MODE REQUIRES DEMO_WALLET_A, DEMO_WALLET_B and DEMO_WALLET_X — the
# backend refuses to start without them. Use addresses the registry has never
# bound: in particular NOT the issuer/deployer address, which deploy.js binds
# as the institutional fallback receiver (registering it would fail with
# "already bound to a different customer identity"). Local mode ignores all of
# these and derives the wallets from the Hardhat mnemonic.
DEMO_WALLET_A=
DEMO_WALLET_B=
DEMO_WALLET_X=
# Guardian shown in the UI and pinned at registration. If GUARDIAN_PK is set,
# this must be GUARDIAN_PK's address, or every claim reverts with
# BadGuardianAttestation.
DEMO_WALLET_G=

# Signs the gasless bridge-advance draw. Its address must equal DEMO_WALLET_B.
DEMO_BORROWER_PK=

# New-guardian candidate generated at deploy time and autofilled into the
# guardian-replacement form. Optional: pin a specific address instead of the
# generated one. Local mode derives it from the Hardhat mnemonic; live mode
# generates a fresh random address on every deploy.
DEMO_NEW_GUARDIAN_ADDRESS=

# Private key whose address becomes the new-guardian candidate (takes
# precedence over the random live-mode generation). If set, the backend can
# co-sign claims as the replacement guardian AFTER a guardian replacement is
# finalized — without it, the demo reverts with BadGuardianAttestation once
# the live guardian changes. Local mode always knows the key (mnemonic-derived),
# so this is only needed for live deployments.
DEMO_NEW_GUARDIAN_PK=

# --- Server -----------------------------------------------------------------
PORT=3000
